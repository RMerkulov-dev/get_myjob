# Скопируй в .env и подставь свои значения.
# ВАЖНО: всё с префиксом VITE_ вшивается в собранный JS и видно в браузере.

# --- Локальная разработка (.env) -----------------------------------------

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Ключ OpenRouter для локального запуска: с ним `npm run dev` ходит в ИИ
# напрямую и не требует Vercel CLI. На Vercel эту переменную НЕ добавляй.
VITE_OPENROUTER_API_KEY=sk-or-v1-...

# Модели. Дорогая нужна только там, где важен связный текст и точность
# извлечения; короткие JSON-ответы (квиз, вопросы рекрутера) считает дешёвая.
# Цены за 1M токенов: flash $0.30/$2.50, flash-lite $0.10/$0.40,
# claude-sonnet-4.5 $3.00/$15.00 — разница до 20 раз.
VITE_OPENROUTER_MODEL=google/gemini-2.5-flash
VITE_OPENROUTER_MODEL_FAST=google/gemini-2.5-flash-lite

# Модель для вкладки CV Check: там нужна сильная редактура текста,
# поэтому по умолчанию она отдельная и дороже остальных.
VITE_OPENROUTER_MODEL_REVIEW=anthropic/claude-sonnet-5


# --- Деплой на Vercel (Project Settings → Environment Variables) ---------
#
#   VITE_SUPABASE_URL         тот же URL
#   VITE_SUPABASE_ANON_KEY    тот же anon-ключ
#   VITE_OPENROUTER_MODEL     модель (иначе gemini-2.5-flash)
#   VITE_OPENROUTER_MODEL_FAST дешёвая модель для JSON (иначе flash-lite)
#   VITE_OPENROUTER_MODEL_REVIEW модель для CV Check (иначе claude-sonnet-5)
#   OPENROUTER_API_KEY        БЕЗ префикса VITE_ — читает только серверная
#                             функция /api/ai, в браузер не попадает
#
# VITE_OPENROUTER_API_KEY на Vercel не добавляй — иначе ключ окажется
# в собранном JS открытым текстом.
